#!/usr/bin/env bash
# dev · main · claude/main에 푸시하기 전에 스모크 묶음(npm run test:smoke)을 돌리고, 실패하면 푸시를 막는다.
# 문서(.md · docs/)만 바뀐 푸시는 건너뛴다. 급할 때는 `git push --no-verify` 또는 `SKIP_SMOKE=1 git push`.
# 작업 트리에 커밋 안 된 변경(다른 세션 것 포함)이 있으면, 푸시하는 커밋만 임시 워크트리에 꺼내 돌린다.
set -uo pipefail

ZERO=0000000000000000000000000000000000000000

# 클라우드 세션(자동 개선 루프)은 `claude/…` 브랜치에만 올린다. 지우기와 `claude/main` 되감기도 막는다.
# Claude 쪽 훅(`scripts/claude-cloud/guard-push.mjs`)은 세션이 뜰 때의 브랜치 설정으로 굳어서, git 쪽에 한 겹 더 둔다.
if [ "${CLAUDE_CODE_REMOTE:-}" = "true" ]; then
  refs=$(cat)
  while read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "$remote_ref" ] && continue
    case "$remote_ref" in
      refs/heads/claude/*) ;;
      *) echo "[pre-push] 자율 모드는 claude/… 브랜치에만 푸시한다: ${remote_ref#refs/heads/} 막음" >&2; exit 1 ;;
    esac
    if [ "$local_sha" = "$ZERO" ]; then
      echo "[pre-push] 브랜치를 지우는 푸시는 사람이 한다: ${remote_ref#refs/heads/} 막음" >&2; exit 1
    fi
    if [ "$remote_ref" = "refs/heads/claude/main" ] && [ "$remote_sha" != "$ZERO" ] && ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
      echo "[pre-push] claude/main은 되감지 않는다(강제 푸시 막음)" >&2; exit 1
    fi
  done <<< "$refs"
  exec <<< "$refs"
fi

[ "${SKIP_SMOKE:-}" = "1" ] && { echo "[pre-push] SKIP_SMOKE=1 — 스모크 건너뜀"; exit 0; }

target=""
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in refs/heads/dev|refs/heads/main|refs/heads/claude/main) ;; *) continue ;; esac
  [ "$local_sha" = "$ZERO" ] && continue
  if [ "$remote_sha" = "$ZERO" ] || ! git cat-file -e "$remote_sha" 2>/dev/null; then
    changed=$(git diff --name-only "$local_sha~1" "$local_sha" 2>/dev/null || echo "?")
  else
    changed=$(git diff --name-only "$remote_sha" "$local_sha")
  fi
  # 문서만 바뀌었으면 건너뛴다.
  if [ -n "$changed" ] && ! printf '%s\n' "$changed" | grep -Ev '(\.md$|^docs/)' >/dev/null; then
    echo "[pre-push] ${remote_ref#refs/heads/}: 문서만 바뀜 — 스모크 건너뜀"
    continue
  fi
  target="$local_sha"
  branch="${remote_ref#refs/heads/}"
done

[ -z "$target" ] && exit 0

root=$(git rev-parse --show-toplevel)
head=$(git rev-parse HEAD)
dirty=$(git -C "$root" status --porcelain --untracked-files=no)

if [ "$target" = "$head" ] && [ -z "$dirty" ]; then
  echo "[pre-push] $branch 푸시 전 스모크 — 이 워크트리에서"
  (cd "$root" && npm run -s test:smoke)
  status=$?
else
  tmp="$root/.claude/worktrees/pre-push-$(git rev-parse --short "$target")-$$"
  echo "[pre-push] $branch 푸시 전 스모크 — 작업 트리에 다른 변경이 있어 푸시하는 커밋만 임시 워크트리에서"
  git worktree add -q --detach "$tmp" "$target" || exit 1
  common=$(cd "$(git rev-parse --git-common-dir)/.." && pwd)
  for link in node_modules .reference-fonts .env .env.local; do
    [ -e "$common/$link" ] && ln -s "$common/$link" "$tmp/$link"
  done
  (cd "$tmp" && npm run -s test:smoke)
  status=$?
  git worktree remove --force "$tmp" >/dev/null 2>&1
fi

if [ $status -ne 0 ]; then
  echo "[pre-push] 스모크 실패 — 푸시를 막았다. 고치고 다시 푸시하거나, 급하면 git push --no-verify" >&2
  exit 1
fi
echo "[pre-push] 스모크 통과"
